        </mxCell>
        <mxCell id="leg3" value="Existing account — API access only (no new payment)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="52" y="146" width="246" height="24" as="geometry" />
        </mxCell>

        <!-- Core platform -->
        <mxCell id="core" value="&lt;b&gt;MakeReady Platform&lt;/b&gt;&lt;br&gt;makeready.g54.com&lt;br&gt;Next.js app (the product)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111111;fontColor=#ffffff;strokeColor=#111111;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="580" y="380" width="240" height="100" as="geometry" />
