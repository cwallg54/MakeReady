          <mxGeometry x="60" y="220" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="neon" value="&lt;b&gt;Neon&lt;/b&gt;&lt;br&gt;Serverless Postgres (all app data)&lt;br&gt;&lt;i&gt;Pay: paid tier (compute + storage + PITR)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="resend" value="&lt;b&gt;Resend&lt;/b&gt;&lt;br&gt;Transactional email (invites, quotes, invoices, proofs)&lt;br&gt;&lt;i&gt;Pay: paid plan for volume · domain g54.com&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
